# ProxyGateway Enterprise — Environment Configuration Example

# Server
PG_SERVER_PORT=8088
PG_METRICS_PORT=9099
PG_ENV=development
PG_READ_TIMEOUT=30s
PG_WRITE_TIMEOUT=60s
PG_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database (Docker-native container)
PG_DB_NAME=proxygateway
PG_DB_USER=proxygateway
# REQUIRED — compose fails if unset. Replace with a strong unique value.
PG_DB_PASS=
PG_DATABASE_URL=postgres://proxygateway:CHANGE_ME@localhost:5432/proxygateway?sslmode=disable
PG_DB_MAX_OPEN_CONNS=25
PG_DB_MAX_IDLE_CONNS=10

# Redis Cache & Ephemeral Rate Limiting
PG_REDIS_URL=redis://localhost:6379/0
PG_REDIS_PASSWORD=

# 9Router Upstream Subsystem
PG_NINEROUTER_URL=http://ninerouter:20128
PG_NINEROUTER_API_KEY=
PG_NINEROUTER_TIMEOUT=60s

# Control Plane & Admin Security
# REQUIRED — compose fails if unset. Replace with a strong unique value.
PG_ADMIN_TOKEN=
